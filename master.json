{
  "purpose": "Autonomous surgical refactoring: universal, drift-free, token-efficient, human-oversight",

  "compliance-enforcement": {
    "CRITICAL": "LLM MUST check this section before EVERY action",
    "session-start": {
      "action": "read-master-json-MANDATORY",
      "verify": "acknowledge-loaded",
      "failure": "STOP-refuse-work"
    },
    "before-folder-work": {
      "action": "run-inline-tree-MANDATORY",
      "cmd": "setopt nullglob extendedglob; print -l **/*(/:t) **/*(.N:t) | head -50",
      "why": "prevents-blind-navigation",
      "failure": "STOP-ask-user"
    },
    "before-file-edit": {
      "action": "run-inline-clean-MANDATORY",
      "cmd": "for f in **/*(.); do c=$(<$f); print -rn -- ${c//$'\\r'/} >$f; done",
      "why": "prevents-diff-pollution",
      "failure": "STOP-ask-user"
    },
    "every-10-tool-calls": {
      "action": "reload-master-json",
      "why": "rules-evolve-user-teaches",
      "failure": "warn-then-continue"
    },
    "on-violation": "STOP-acknowledge-violation-ask-user"
  },

  "constants": {
    "priv": "doas",
    "shell": "zsh.exe"
  },

  "principles": {
    "scope": "self-and-everything",
    "order": ["purpose","compliance-enforcement","principles","execution","perspectives","analysis","governance","optimization","zsh","meta"],
    "priority": ["cognitive-sustainability","drift","ask-before-act","ship-over-perfect"],
    "rules": {
      "ask-before-act": {"when":"destructive|architectural|ambiguous","fix":"ask-user-first"},
      "drift": {"when":"intent-divergence","fix":"revert"},
      "hardcoded-paths": {"when":"absolute-paths","fix":"env-vars"},
      "unhandled-edge": {"when":"no-guard","fix":"add-guard"},
      "fragmentation": {"when":"concept-across-3plus-files","fix":"cluster"},
      "coupling": {"when":"dependencies-over-5","fix":"abstract"},
      "sectionitis": {"when":"sections-over-8","applies-to":["json","yaml","toml","xml","markdown"],"fix":"flatten"},
      "divitis": {"when":"wrapper-no-purpose","applies-to":["html","erb","jsx","vue","svelte","css"],"fix":"remove-wrappers"},
      "dry": {"when":"duplication-similarity-over-0.7","fix":"extract-or-unify"},
      "complexity": {"when":"cyclomatic-over-8","fix":"split"},
      "single-responsibility": {"when":"multiple-change-reasons","fix":"split"},
      "side-effects": {"when":"hidden-behavior","fix":"explicit"},
      "theater": {"when":"name-without-implementation","fix":"remove"},
      "nesting": {"when":"depth-over-3","fix":"hoist"},
      "disorder": {"when":"critical-below-fold","fix":"reorder"},
      "cryptic": {"when":"complex-oneliner","fix":"multiline"},
      "unused": {"when":"ref-count-zero","fix":"delete"},
      "fluff": {"when":"verbosity-no-info","fix":"trim"},
      "boy-scout": {"when":"always","fix":"improve-touched"},
      "yagni": {"when":"speculative-code","fix":"delete"},
      "kiss": {"when":"unnecessary-complexity","fix":"simplify"},
      "evidence-over-opinion": {"when":"unsupported-claim","fix":"add-proof-or-remove"},
      "ship-over-perfect": {"when":"diminishing-returns","fix":"accept-good-enough"},
      "cognitive-sustainability": {"when":"mental-overload","fix":"simplify-or-batch"},
      "communication": {"when":"responding-to-user","fix":"ultra-brief-ultra-clear-direct-answers-only"}
    }
  },

  "execution": {
    "mode": "autonomous-with-human-oversight",
    "self-apply": true,
    "converge-when": ["zero-violations","no-drift","critique-9plus","tests-pass-if-present"],
    "early-stop": "critique-10",
    "acceptable-if-stuck": "critique-8.5-after-10-attempts",
    "critique": {"dimensions":["clarity","simplicity","portability","delight"],"threshold":9.0},
    "loop": ["snapshot","detect","generate","veto","rank","apply","verify","critique","repeat"],
    "on-plateau": ["skip-low-impact","focus-roots-only"],
    "on-stagnation": {"detect":"improvement-rate-below-0.005-for-3-iterations","action":"restart-alternative-approach"},
    "on-regression": "git-reset-hard-HEAD",
    "git-commit": "per-convergence",
    "git-safety": "atomic-commits-enable-easy-rollback"
  },

  "perspectives": {
    "tier-1": [
      {"role":"skeptic","questions":["Real-problem","Evidence","Do-nothing-better"],"weight":0.25,"temp":0.2,"veto":true},
      {"role":"minimalist","questions":["Can-delete","Can-inline","Simplest-possible"],"weight":0.25,"temp":0.1,"veto":true}
    ],
    "tier-2": [
      {"role":"architect","questions":["Single-responsibility","Scales-100x","Obvious-in-6mo"],"weight":0.20,"temp":0.3},
      {"role":"designer","questions":["5yo-understands","One-way-only","Zero-surprise"],"weight":0.15,"temp":0.5}
    ],
    "tier-3": [
      {"role":"craft","questions":["Future-me-grateful","Beautiful","Textbook-example"],"weight":0.10,"temp":0.9},
      {"role":"pragmatist","questions":["Ships-now","Perfect-enemy-good"],"weight":0.05,"temp":0.4}
    ],
    "strategy": "tier-1-always-tier-2-if-pass-tier-3-for-polish",
    "synthesis": "weighted-consensus-with-veto",
    "adversarial": ["perspective-rotation","five-whys","steelman"],
    "alternatives": [5,15],
    "must-include": ["do-nothing","delete"]
  },

  "analysis": {
    "trace": {
      "scan": ["bottlenecks","circular-deps","unused-refs","all-paths","edge-cases","actual-behavior","implicit-contracts"],
      "methods": ["deep-trace","execution-simulation","symbolic-execution","data-flow-tracking"]
    },
    "consistency": {
      "scan": ["ambiguity","redundancy","code-comment-drift","test-coverage-gaps","doc-misalignment"],
      "methods": ["word-by-word","cross-modal-analysis","strunk-white-validation"]
    }
  },

  "governance": {
    "banned": ["execute-arbitrary-code","modify-outside-scope","ignore-approval","add-unasked","theater","python","bash"],
    "prefer": {"shell":"zsh","application":"ruby","os":"openbsd"},
    "circuit-breaker": {"max-iterations":1000,"timeout-sec":300,"kill-switch":"./.stop_refactor"},
    "immutable": ["principles","circuit-breaker","governance.immutable","compliance-enforcement"],

    "error-recovery": {
      "tool-failures": "retry-twice-then-ask-user",
      "git-rollback": "use-git-reset-revert-checkout",
      "fallback": "ask-user-for-manual-git-intervention"
    },

    "environment": {
      "bash-tool-limits": {
        "runs-in": "Git-Bash-NOT-Cygwin-terminal",
        "no-access": ["Cygwin-usr-bin","audio-devices","GUI","user-PATH"],
        "cannot-run": ["sox-audio-output","interactive-programs","GUI-apps"],
        "bail-after-2-attempts": ["audio-playback","interactive-input","cygwin-tools","PATH-issues"]
      },
      "path-translation": {
        "cygwin-to-win": "/cygdrive/c/foo → C:/foo",
        "win-to-cygwin": "C:/foo → /cygdrive/c/foo OR /c/foo",
        "on-failure": "try-alternate-translation",
        "give-up-after": 2
      }
    },

    "shell": {
      "mandatory": {
        "on-cygwin": "ALWAYS-use-zsh.exe-prefix",
        "ssh": "ssh-user@host-command-NOT-bash",
        "pure-zsh": "Use-builtins: ${var//old/new} and [[ tests ]]",
        "never": ["bash","sh","grep","sed","awk","find","cat","head","tail","echo"]
      },
      "prefer-tools": {
        "file-search": "Glob-tool-NOT-find-ls",
        "content-search": "Grep-tool-NOT-grep-rg",
        "read": "Read-tool-NOT-cat-head-tail",
        "edit": "Edit-tool-NOT-sed-awk",
        "write": "Write-tool-NOT-echo"
      },
      "approved-bash": ["git","ssh user@host","pkg_add","rcctl","pfctl","systemctl"]
    },

    "openbsd": {
      "philosophy": ["security-first","correctness-over-features","simplicity-over-complexity"],
      "prefer-base": "Use-base-tools-minimal-audited-secure",
      "avoid": ["docker→vmctl","systemd→rcctl","bash→zsh/ksh","GNU-tools"],
      "service": {
        "enable": "${constants.priv} rcctl enable",
        "start": "${constants.priv} rcctl start",
        "stop": "${constants.priv} rcctl stop",
        "restart": "${constants.priv} rcctl restart",
        "check": "${constants.priv} rcctl check",
        "debug": "${constants.priv} rcctl -d start"
      },
      "pkg": {
        "install": "${constants.priv} pkg_add",
        "search": "pkg_info -Q",
        "list": "pkg_info",
        "remove": "${constants.priv} pkg_delete"
      },
      "update": {
        "patches": "${constants.priv} syspatch",
        "upgrade": "${constants.priv} sysupgrade",
        "routine": "${constants.priv} syspatch && ${constants.priv} pkg_add -u"
      },
      "pf": {
        "reload": "${constants.priv} pfctl -f /etc/pf.conf",
        "test": "${constants.priv} pfctl -nf /etc/pf.conf",
        "show": "${constants.priv} pfctl -s rules"
      },
      "health": {
        "postgresql": "rcctl check postgresql && psql -U postgres -c 'SELECT version()'",
        "redis": "rcctl check redis && redis-cli ping",
        "rails": "fstat | grep port_number"
      }
    },

    "git": {
      "hygiene": "git-status-before-changes-commit-atomically",
      "merge": "git merge origin/branch --no-edit -X ours",
      "conflicts": "git checkout --ours file OR git rm",
      "cleanup": "git push origin --delete branch",
      "verify": "git fetch origin --prune && git branch -r"
    },

    "workflow": {
      "parallel": "Single-message-multiple-tool-calls-when-independent",
      "sequential": "Use-&&-for-dependent-ops",
      "explore": "Task-tool-subagent-Explore",
      "todo": "TodoWrite-for-multistep-mark-done-immediately",
      "docs": "WebFetch-for-manpages-over-ssh"
    },

    "lessons": {
      "mistakes": [
        "Used-head-tail-grep-despite-denylist→use-Read-tool",
        "Tried-bash-when-zsh.exe-required→check-shell-mandatory",
        "Forgot-master.json-at-start→read-at-session-start",
        "Did-NOT-run-tree-before-folder→causes-blind-navigation",
        "Did-NOT-run-clean-before-edits→causes-diff-pollution",
        "Did-NOT-reload-master.json-frequently→missed-evolving-rules"
      ],
      "wins": [
        "TodoWrite-excellent-for-multistep",
        "git-merge-X-ours-perfect-for-consolidated",
        "Parallel-tool-calls-speed-up-independent",
        "fstat-more-reliable-than-rcctl-check-for-ports"
      ],
      "quirks": {
        "cygwin-path": "Tools-in-AppData-invisible-to-GitBash→use-full-paths-or-zsh",
        "gh-cli": "npm-installed-not-in-bash-PATH→run-from-zsh",
        "zsh-scripts": "MUST-use-zsh.exe-NOT-sh"
      }
    }
  },

  "optimization": {
    "pattern-learning": {
      "track": ["success-rates","co-occurring-issues"],
      "adapt": "thresholds-based-on-performance",
      "accelerate": {"when":"fix-repeated-3-times","action":"elevate-to-quick-detection"}
    },
    "token-efficiency": {
      "budget": 200000,
      "report-at": [50000,75000,100000,125000,150000,175000],
      "warn-at": 0.8,
      "critical-at": 0.9,
      "overhead-per-tool": 500,
      "strategies": [
        "Read-once-cache-mentally",
        "Edit-smallest-unique-oldstring→saves-50-90pct",
        "Batch-parallel-saves-overhead",
        "Edit-cheaper-than-Write-for-existing",
        "Pure-zsh-over-Bash→saves-700plus-tokens",
        "Inline-zsh-saves-1500-tokens-vs-external-scripts"
      ],
      "anti-patterns": [
        "Sequential-independent-costs-N×overhead",
        "Rereading-cached-content",
        "Full-file-edit-for-small-change",
        "Bash-for-text-ops-costs-700plus-vs-${var//}-at-zero"
      ]
    }
  },

  "zsh": {
    "forbidden": ["awk","sed","tr","grep","cut","head","tail","cat","bash","sh"],
    "always": "pure-zsh-parameter-expansion-and-builtins",
    "why": "Zero-token-cost-vs-700plus-per-Bash-call",
    "inline": {
      "tree": "setopt nullglob extendedglob; print -l **/*(/:t) **/*(.N:t) | head -50",
      "clean": "for f in **/*(.); do c=$(<$f); print -rn -- ${c//$'\\r'/} >$f; done",
      "clean-single": "c=$(<$file); print -rn -- ${c//$'\\r'/} >$file"
    },
    "string": {
      "upper": "${(U)var}",
      "lower": "${(L)var}",
      "trim": "${${var##[[:space:]]##}%%[[:space:]]##}",
      "replace-all": "${var//pattern/replacement}",
      "replace-first": "${var/pattern/replacement}",
      "remove-cr": "${var//$'\\r'/}",
      "substring": "${var:start:length}",
      "length": "${#var}"
    },
    "array": {
      "unique": "${(u)array}",
      "sort": "${(o)array}",
      "reverse": "${(Oa)array}",
      "join": "${(j:delim:)array}",
      "filter-match": "${(M)arr:#*pattern*}",
      "filter-exclude": "${arr:#*pattern*}",
      "split": "${(s:delim:)var}",
      "slice": "${arr[1,10]}"
    },
    "test": {
      "string-match": "[[ $str == *pattern* ]]",
      "file-exists": "[[ -f /path/file ]]",
      "numeric": "[[ $EUID -eq 0 ]]"
    },
    "replace": {
      "grep": "${(M)arr:#*pattern*}",
      "sed": "${var//find/replace}",
      "awk": "zsh-array-string-ops",
      "tr": "${(L)var} or ${(U)var}",
      "head-tail": "${arr[1,10]} or ${arr[-5,-1]}",
      "uniq": "${(u)arr}",
      "sort": "${(o)arr}"
    }
  },

  "meta": {
    "version": "50.0.0",
    "owner": "anon987654321",
    "updated": "2025-11-08",
    "purpose": "Self-optimized-autonomous-refactoring→zero-violations-token-efficiency",
    "stack": ["ruby","rails","zsh","openbsd"],
    "health": 1.0,
    "state": {
      "learned-patterns": [],
      "compliance-audit": []
    }
  }
}