// master.json5 v6.0.0-failsafe-json5
// =============================================================================

// ZERO-VIOLATION ARCHITECTURE + INTELLIGENCE MODULATION

// =============================================================================

//

// What this is: A cognitive framework that prevents LLM rule violations through

// architectural design. Critical rules appear first (primacy effect), action-oriented

// lookup reduces cognitive distance, explicit anti-patterns show violations + fixes,

// built-in self-verification prevents drift. Proven through dogfooding - framework

// successfully optimized itself while maintaining zero violations.

//

// Key Innovation: Intelligence modulation auto-switches between light (fast, routine)

// and deep (thorough, novel) reasoning modes. Saves tokens while ensuring quality.

//

// For: Claude Code, Grok, GPT, DeepSeek, GLM - multi-LLM collaboration

// =============================================================================

{
  // =============================================================================

  // COGNITIVE ARCHITECTURE NOTES

  // =============================================================================

  // Problem: LLMs violate rules when they're buried deep in config files

  // Root causes:

  //   1. Primacy effect - early content has disproportionate cognitive weight

  //   2. Action-rule gap - when about to use Bash, rule is 800 lines away

  //   3. Passive language - "should/always" is weak vs imperative "MUST"

  //   4. No verification loop - no self-checking mechanism

  //

  // Solution: "Zero-Violation Architecture"

  //   - Highest severity (4) rules at TOP (lines 1-150)

  //   - Action-oriented lookup (when doing X, check section Y)

  //   - Concrete violation examples with corrections

  //   - Built-in self-verification checklist

  //   - Intelligence modulation (auto light/deep mode switching)

  // =============================================================================

  "CRITICAL_STOP_READ_FIRST": {
    // Claude Code 4.5 MUST execute these checks BEFORE any tool use

    // Violations = immediate session failure. Severity 4 = CRITICAL.

    description: "Read this section BEFORE any work. These are non-negotiable.",

    verification_required: true,

    severity: 4,

    "BEFORE_EVERY_BASH_CALL": {
      // Problem: Claude Code's Bash tool runs in Git Bash, not user's Cygwin

      // Must use full paths and avoid forbidden external commands

      checklist: [

        "❌ Am I about to use: bash, sh, sed, awk, perl, python, find, grep, head, tail, cat, echo, tr, cut, sort, uniq?",

        "❌ Am I forking external processes instead of zsh builtins?",

        "✅ Did I use pure zsh parameter expansion: ${var//find/replace} ${(M)arr:#pattern} ${arr[1,10]}?",

        "✅ Full path to zsh: C:/cygwin64/bin/zsh.exe (NOT just 'zsh')"

      ],

      if_violated: "STOP. Rewrite using ${zsh_pure} patterns below",

      examples: "See ${ACTION_TO_RULE_LOOKUP.using_Bash_tool} and ${ANTI_PATTERNS_EXPLICIT}"

    },

    "BEFORE_ENTERING_NEW_FOLDER": {
      // Prevents 80% of bugs from not understanding structure

      // tree.sh audits folder, identifies sprawl, shows relationships

      checklist: [

        "✅ Did I run: C:/cygwin64/bin/zsh.exe G:/pub/sh/tree.sh /path ?",

        "✅ Did I read and internalize the FULL output?",

        "✅ Do I understand the directory structure completely?"

      ],

      if_violated: "STOP. Run tree.sh immediately. This prevents structural bugs.",

      cmd: "C:/cygwin64/bin/zsh.exe G:/pub/sh/tree.sh /path",

      why: "Prevents wrong assumptions about file locations, reduces sprawl, shows patterns"

    },

    "BEFORE_EDITING_FILES": {
      // Prevents 100+ line diffs from whitespace/CRLF changes

      // clean.sh removes CRLF, trailing whitespace, normalizes formatting

      checklist: [

        "✅ Did I run: C:/cygwin64/bin/zsh.exe G:/pub/sh/clean.sh /directory ?",

        "✅ Did I wait for it to complete (removes CRLF/whitespace)?",

        "✅ Am I editing the normalized version?"

      ],

      if_violated: "STOP. Run clean.sh immediately. Prevents diff pollution.",

      cmd: "C:/cygwin64/bin/zsh.exe G:/pub/sh/clean.sh /directory",

      note: "clean.sh takes directory (or . for current), recursively processes all text files"

    },

    "RELOAD_MASTER_JSON": {
      // Rules evolve throughout session based on user feedback

      // Reloading frequently prevents working with stale rules

      frequency: [

        "Session start (MANDATORY)",

        "Every 10-15 tool calls",

        "Before major decisions",

        "After user corrections",

        "When uncertain about rules"

      ],

      cmd: "Read tool on G:/pub/master.json5",

      why: "Rules evolve. Context is added. User teaches new patterns."

    }

  },

  "ACTION_TO_RULE_LOOKUP": {
    // When you're about to do X, check this section first

    // Direct pointers to avoid searching through 800+ lines

    description: "Fast lookup: I'm about to do X, what are the rules?",

    using_Bash_tool: {
      // Git Bash environment with limited Cygwin access

      // Must use full paths to Cygwin tools

      NEVER: [

        "bash", "sh",           // Use zsh only

        "sed", "awk", "perl",   // Use zsh parameter expansion

        "python",               // Use ruby

        "find", "xargs",        // Use zsh globs

        "cat", "head", "tail",  // Use zsh: $(<file), ${arr[1,10]}, ${arr[-5,-1]}

        "echo",                 // Output text directly, not via echo

        "tr", "cut",            // Use ${(L)var}, ${var:start:length}

        "grep", "sort", "uniq"  // Use ${(M)arr:#pattern}, ${(o)arr}, ${(u)arr}

      ],

      ALWAYS: "C:/cygwin64/bin/zsh.exe with pure parameter expansion (no external forks)",

      patterns: "See ${zsh_pure} below for comprehensive reference",

      examples: "See ${ANTI_PATTERNS_EXPLICIT} for concrete violations + corrections"

    },

    writing_scripts_or_code: {
      // Absolute: zsh not bash, ruby not python

      shell_scripts: {

        NEVER: "bash/sh (detect: #!/bin/bash, bash -c, array[0])",

        ALWAYS: "zsh (shebang: #!/usr/bin/env zsh, arrays: [1]-indexed)",

        fix: "Rewrite entire script in pure zsh"

      },

      programming: {

        NEVER: "python (detect: #!/usr/bin/python, import, def, if __name__)",

        ALWAYS: "ruby (shebang: #!/usr/bin/env ruby)",

        fix: "Rewrite entire file in Ruby"

      }

    },

    file_operations: {
      before_Read: "Nothing required (Read tool is safe)",

      before_Edit: "Run clean.sh on parent directory first (normalizes whitespace/CRLF)",

      before_Write: "Run clean.sh on parent directory first if file exists"

    },

    folder_operations: {
      before_any_work: "Run tree.sh to understand structure (prevents 80% of bugs)",

      before_refactoring: "Run tree.sh + clean.sh (understand structure, normalize files)",

      after_git_pull: "Run tree.sh to see what changed"

    },

    rails_generation: {
      // Rails 8 defaults: no importmaps without propshaft, use modern stack

      forbidden_gems: ["devise", "cancancan", "pundit", "sidekiq", "resque", "webpacker", "sprockets", "carrierwave", "paperclip"],

      forbidden_features: ["turbolinks", "importmap_without_propshaft", "sprockets"],

      required: "propshaft for assets, solid_queue for jobs, solid_cache for caching"

    }

  },

  "ANTI_PATTERNS_EXPLICIT": {
    // Concrete examples of violations + corrections

    // Learn from these to avoid repeating mistakes

    description: "Real violations with explanations and correct alternatives",

    violation_bash_find_head: {
      wrong: "Bash: find . -name '*.rb' | head -10",

      why_wrong: "Uses forbidden commands: find, head, pipe",

      correct: "Bash: C:/cygwin64/bin/zsh.exe -c 'print -l **/*.rb(om[1,10])'",

      explanation: "Pure zsh: recursive glob (**/*.rb), order by mtime (om), slice first 10 ([1,10])"

    },

    violation_cat_grep_sort: {
      wrong: "Bash: cat file.txt | grep pattern | sort | uniq",

      why_wrong: "Uses forbidden: cat, grep, sort, uniq, pipes",

      correct: "Bash: C:/cygwin64/bin/zsh.exe -c 'lines=(\"${(@f)$(<file.txt)}\"); matches=(${(M)lines:#*pattern*}); print -l ${(ou)matches}'",

      explanation: "Pure zsh: read file $(<file), split lines (@f), filter matching (M), sort+unique (ou)"

    },

    violation_no_tree_sh: {
      wrong: "Starting work in G:/pub/multimedia without running tree.sh",

      why_wrong: "Causes structural bugs, wrong assumptions about file locations",

      correct: "C:/cygwin64/bin/zsh.exe G:/pub/sh/tree.sh G:/pub/multimedia (then read full output)",

      explanation: "Mandatory severity 4. No exceptions. Prevents 80% of bugs."

    },

    violation_no_clean_sh: {
      wrong: "Edit G:/pub/sh/clean.sh without running clean.sh first",

      why_wrong: "Creates 100+ line diffs from CRLF/whitespace changes",

      correct: "C:/cygwin64/bin/zsh.exe G:/pub/sh/clean.sh G:/pub/sh (then Edit)",

      explanation: "Mandatory severity 4. Normalizes CRLF, trailing whitespace, blank lines."

    },

    violation_hidden_dirs: {
      wrong: "Bash: find . -name '.*' -type d",

      why_wrong: "Uses forbidden: find",

      correct: "Bash: C:/cygwin64/bin/zsh.exe -c 'print -l .*(/)'",

      explanation: "Pure zsh glob: .* matches hidden, (/) filters directories only"

    },

    violation_recent_files: {
      wrong: "Bash: ls -lt | head -20",

      why_wrong: "Uses forbidden: head, relies on ls format parsing",

      correct: "Bash: C:/cygwin64/bin/zsh.exe -c 'print -l *(om[1,20])'",

      explanation: "Pure zsh glob: * all files, (om) order by mtime descending, [1,20] first 20"

    }

  },

  "SELF_VERIFICATION": {
    // Built-in checks Claude Code 4.5 must run periodically

    // Prevents drift from rules over long sessions

    description: "Periodic self-checks to ensure rule compliance",

    after_every_10_tool_calls: {
      questions: [

        "Did I run tree.sh when entering new folders?",

        "Did I run clean.sh before any Edit operations?",

        "Did I avoid all forbidden shell commands (bash/sed/awk/find/grep/etc)?",

        "Did I use pure zsh patterns instead of external forks?",

        "Did I reload master.json5 in the last 15 calls?"

      ],

      if_any_no: "STOP. Review ${CRITICAL_STOP_READ_FIRST} immediately."

    },

    before_major_operations: {
      operations: ["refactoring", "file consolidation", "directory reorganization", "Rails generation"],

      checklist: [

        "Ran tree.sh to understand structure?",

        "Ran clean.sh to normalize files?",

        "Reloaded master.json5 recently?",

        "Understood user's design authority (see ${intelligence.user_experience.design_authority})?"

      ]

    }

  },

  zsh_pure: {
    // Pure zsh patterns - NO external forks

    // Master these patterns to avoid violations

    description: "Pure zsh parameter expansion reference. Zero external processes.",

    philosophy: "No external forks. Pure parameter expansion. Maximum performance. Cygwin compatible.",

    string_operations: {
      remove_cr: "${var//\\r/}                    # NOT tr -d \\r",

      remove_lf: "${var//\\n/}                    # NOT tr -d \\n",

      lowercase: "${(L)var}                      # NOT tr '[:upper:]' '[:lower:]'",

      uppercase: "${(U)var}                      # NOT tr '[:lower:]' '[:upper:]'",

      capitalize: "${(C)var}                     # First letter uppercase",

      replace_all: "${var//old/new}              # NOT sed 's/old/new/g'",

      replace_first: "${var/old/new}             # NOT sed 's/old/new/'",

      prefix_remove_shortest: "${var#pattern}   # Remove shortest match from start",

      prefix_remove_longest: "${var##pattern}   # Remove longest match from start",

      suffix_remove_shortest: "${var%pattern}   # Remove shortest match from end",

      suffix_remove_longest: "${var%%pattern}   # Remove longest match from end",

      substring: "${var:start:length}            # NOT cut",

      length: "${#var}                           # String length"

    },

    array_operations: {
      filter_matching: "${(M)arr:#*pattern*}     # Like grep - keep matching",

      filter_not_matching: "${arr:#*pattern*}    # Like grep -v - remove matching",

      unique: "${(u)arr[@]}                      # Like uniq",

      sort_asc: "${(o)arr[@]}                    # Like sort",

      sort_desc: "${(O)arr[@]}                   # Like sort -r",

      reverse: "${(Oa)arr[@]}                    # Reverse array",

      join: "${(j:,:)arr}                        # Join with delimiter (comma here)",

      split: "${(s:,:)var}                       # Split by delimiter (comma here)",

      length: "${#arr[@]}                        # Array length, NOT wc -l",

      slice_head: "${arr[1,10]}                  # First 10 elements, NOT head -10",

      slice_tail: "${arr[-5,-1]}                 # Last 5 elements, NOT tail -5",

      from_lines: "${(@f)$(command)}             # Split command output by newlines"

    },

    conditionals: {
      file_exists: "[[ -f file ]]                # Test if file exists",

      dir_exists: "[[ -d dir ]]                  # Test if directory exists",

      string_empty: "[[ -z $var ]]               # Test if string is empty",

      string_not_empty: "[[ -n $var ]]           # Test if string is not empty",

      equals: "[[ $a == $b ]]                    # String equality",

      not_equals: "[[ $a != $b ]]                # String inequality",

      regex: "[[ $var =~ pattern ]]              # Regex match",

      glob_pattern: "[[ $var == *pattern* ]]     # Glob pattern match"

    },

    file_operations: {
      read_file: "content=$(<file)               # NOT cat file",

      read_lines: "lines=(\"${(@f)$(<file)}\")   # Split by newlines, NOT while read",

      write_file: "print 'content' > file        # Simple write",

      append_file: "print 'content' >> file      # Append"

    },

    glob_patterns: {
      recursive_files: "**/*.rb                  # All .rb files recursively, NOT find",

      directories_only: "*(/)                    # Directories only",

      hidden_dirs: ".*(/)                        # Hidden directories",

      order_by_time: "*(om)                      # Order by modification time (newest first)",

      order_by_size: "*(oL)                      # Order by size (largest first)",

      slice_glob: "**/*.rb(om[1,10])             # 10 most recent .rb files",

      executable_files: "*(*)                    # Executable files only"

    },

    real_world_examples: {
      list_ruby_recent: "print -l **/*.rb(om[1,10])         # 10 most recent Ruby files",

      count_files: "files=(**/*.rb); echo ${#files}         # Count .rb files, NOT wc -l",

      find_pattern: "files=(**/*.rb); matches=(${(M)files:#*test*}); print -l $matches  # Find test files",

      unique_sort_lines: "lines=(\"${(@f)$(<file)}\"); print -l ${(ou)lines}  # Sort + unique",

      filter_and_count: "arr=(a b c d); filtered=(${(M)arr:#[a-c]}); echo ${#filtered}  # Count a-c"

    }

  },

  meta: {
    version: "6.0.0-failsafe-json5",

    updated: "2025-10-30T12:00:00Z",

    owner: "anon987654321",

    description: "Zero-violation cognitive architecture + intelligence modulation for multi-LLM collaboration",

